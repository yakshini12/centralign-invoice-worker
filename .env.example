# Reference values only: the app reads process environment and does not auto-load this file.
# OpenAI-compatible API root. Ollama's default local endpoint is shown here.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Leave blank for local models; set only if your endpoint requires it.
LLM_API_KEY=

# This local simulation commits the first draft write, then returns a timeout
# so the agent must reconcile by reading the AP system before reporting success.
SIMULATE_COMMIT_TIMEOUT=true
# Optional; defaults to ./runtime/app.sqlite3
# INVOICE_WORKER_DB=./runtime/app.sqlite3
